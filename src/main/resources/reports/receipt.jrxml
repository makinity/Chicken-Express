<?xml version="1.0" encoding="UTF-8"?>
<!--
    ChickenExpress — receipt.jrxml
    JasperReports template for a single order receipt (PDF).

    This is a STUB template. Fill in the actual layout when
    implementing Phase 2 PDF receipt generation in ReportService.

    Expected parameters (passed from Java via JRBeanCollectionDataSource or Map):
      - ORDER_NUMBER (String)
      - ORDER_DATE   (String, formatted)
      - CUSTOMER_NAME (String)
      - ORDER_TYPE   (String)
      - TOTAL_AMOUNT (String, pre-formatted "₱XXX.XX")

    Expected fields (from the collection datasource — OrderItem list):
      - productName (String)
      - quantity    (Integer)
      - unitPrice   (String, "₱XXX.XX")
      - subtotal    (String, "₱XXX.XX")

    To compile: JasperCompileManager.compileReportToFile("receipt.jrxml")
    To fill:    JasperFillManager.fillReport(compiledReport, params, datasource)
    To export:  JasperExportManager.exportReportToPdf(jasperPrint)
-->
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="receipt"
    pageWidth="595" pageHeight="842"
    columnWidth="535" leftMargin="30" rightMargin="30"
    topMargin="30" bottomMargin="30">

    <!-- ── Parameters ───────────────────────────────────────────────── -->
    <parameter name="ORDER_NUMBER"   class="java.lang.String"/>
    <parameter name="ORDER_DATE"     class="java.lang.String"/>
    <parameter name="CUSTOMER_NAME"  class="java.lang.String"/>
    <parameter name="ORDER_TYPE"     class="java.lang.String"/>
    <parameter name="TOTAL_AMOUNT"   class="java.lang.String"/>

    <!-- ── Fields (from datasource) ────────────────────────────────── -->
    <field name="productName" class="java.lang.String"/>
    <field name="quantity"    class="java.lang.Integer"/>
    <field name="unitPrice"   class="java.lang.String"/>
    <field name="subtotal"    class="java.lang.String"/>

    <!-- ── Title Band ───────────────────────────────────────────────── -->
    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[ChickenExpress Receipt]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="535" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Order: " + $P{ORDER_NUMBER} + " | " + $P{ORDER_DATE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="55" width="535" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{CUSTOMER_NAME} + " | " + $P{ORDER_TYPE}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- ── Column Header ────────────────────────────────────────────── -->
    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0"   y="5" width="270" height="15"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Item]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="5" width="70"  height="15"/>
                <textElement textAlignment="Center"><font isBold="true"/></textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="5" width="100" height="15"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Unit Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="5" width="95"  height="15"/>
                <textElement textAlignment="Right"><font isBold="true"/></textElement>
                <text><![CDATA[Subtotal]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ── Detail Band (one row per OrderItem) ──────────────────────── -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0"   y="2" width="270" height="15"/>
                <textFieldExpression><![CDATA[$F{productName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="2" width="70"  height="15"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="2" width="100" height="15"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="440" y="2" width="95"  height="15"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ── Summary (total) ──────────────────────────────────────────── -->
    <summary>
        <band height="40">
            <staticText>
                <reportElement x="340" y="10" width="100" height="20"/>
                <textElement textAlignment="Right"><font isBold="true" size="13"/></textElement>
                <text><![CDATA[TOTAL:]]></text>
            </staticText>
            <textField>
                <reportElement x="440" y="10" width="95" height="20"/>
                <textElement textAlignment="Right"><font isBold="true" size="13"/></textElement>
                <textFieldExpression><![CDATA[$P{TOTAL_AMOUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
